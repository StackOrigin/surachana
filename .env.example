# Leave empty for a fully static production build.
# In development, the app falls back to http://127.0.0.1:4000.
VITE_API_BASE_URL=

# Optional. Leave blank to let the backend resolve the current school by host/default.
# Set one of these when deploying the site for a specific school.
VITE_SCHOOL_ID=
# School slug used for the admission-forms upload endpoint. Defaults to VITE_SCHOOL_ID.
VITE_SCHOOL_SLUG=

# Set to true when the website should always use bundled school data.
VITE_DISABLE_BACKEND=false

# The admin screen is a development preview, not a secured production system.
VITE_ENABLE_ADMIN=false

# Admission form submission (Backend API).
# The filled application PDF is uploaded to the backend, and basic admission
# data is sent as an inquiry so it appears in the admin panel.
# These EmailJS variables are kept for legacy/fallback use but are no longer
# required by the admission form.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# School inbox that receives the admission application PDF.
VITE_ADMISSION_TO_EMAIL=
